# Copy this file to `.env` and fill in your AWS credentials.
# `.env` is gitignored — never commit secrets.
#
# These are used ONLY for the Remotion CLI commands that deploy the
# rendering Lambda + push the bundled site to S3. Once Phase 1 is up,
# the production backend talks to Remotion Lambda using its Lambda
# execution role (no static keys at runtime).

REMOTION_AWS_ACCESS_KEY_ID=AKIA....................
REMOTION_AWS_SECRET_ACCESS_KEY=........40 chars........
REMOTION_AWS_REGION=us-east-1
