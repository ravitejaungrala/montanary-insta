%%{init: {'flowchart': {'nodeSpacing': 30, 'rankSpacing': 42, 'padding': 8, 'curve': 'linear', 'wrappingWidth': 160, 'useMaxWidth': true, 'htmlLabels': true}, 'themeVariables': {'fontFamily': 'Inter, Helvetica, Arial, sans-serif', 'fontSize': '14px'}}}%%
%% LinkedIn Sequence Engine — Branching State Machine
flowchart TB
  subgraph g_first["First Touch"]
    direction TB
    new["NEW<br/><small>lead enrolled</small>"]
    connreq["Connection Request<br/><small>send_connection_request / connect_and_inmail</small>"]
    sent["PENDING<br/><small>invite sent</small>"]
  end
  subgraph g_gate["Acceptance Check (+2d)"]
    direction TB
    checkacc{"Accepted?<br/><small>detect_acceptance (DOM)</small>"}
    declined["NOT ACCEPTED<br/><small>pending after N / declined</small>"]
    accepted["ACCEPTED"]
  end
  subgraph g_inmail["Not Accepted → InMail Branch"]
    direction TB
    inm1["inmail_1<br/><small>skipped if no InMail credit</small>"]
    inm2["inmail_followup"]
    inm3["inmail_followup_2"]
    closei["close_inmail"]
  end
  subgraph g_msg["Accepted → Message Branch"]
    direction TB
    msg1["message_1"]
    chkr1["check_reply_1<br/><small>reply → STOP</small>"]
    msg2["message_2"]
    chkr2["check_reply_2<br/><small>reply → STOP</small>"]
    closem["close_message"]
  end
  subgraph g_end["Terminal States"]
    direction TB
    completed["COMPLETED"]
    stopped["STOPPED<br/><small>reply / demo / unsubscribe</small>"]
  end
  new --> connreq
  connreq --> sent
  sent -->|"+2d"| checkacc
  checkacc -->|"no"| declined
  checkacc -->|"yes"| accepted
  accepted --> msg1
  msg1 --> chkr1
  chkr1 --> msg2
  msg2 --> chkr2
  chkr2 --> closem
  closem --> completed
  declined --> inm1
  inm1 --> inm2
  inm2 --> inm3
  inm3 --> closei
  closei --> completed
  chkr1 -->|"reply"| stopped
  chkr2 --> stopped
  inm1 -.->|"late accept"| accepted
